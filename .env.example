# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ones_panel?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# API
PORT="3001"
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-me-to-a-secure-random-string"
JWT_EXPIRES_IN="7d"

# VPS Deploy Bot (Discord)
DISCORD_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_ADMIN_IDS=""
DISCORD_ADMIN_ROLE_ID=""

# VPS Deploy Bot Settings
VPS_MAX_PER_USER="3"
VPS_DEFAULT_OS="ubuntu:22.04"
VPS_DOCKER_NETWORK="bridge"
VPS_MAX_CONTAINERS="100"
VPS_WATERMARK="VPS Service"
VPS_WELCOME_MESSAGE="Welcome! Get Started With Us!"
VPS_HOSTNAME_PREFIX="vps"
VPS_DOCKER_IMAGE_PREFIX="panel"
